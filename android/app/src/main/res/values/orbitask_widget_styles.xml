<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OrbitaskWidgetTaskRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#F3F5F7</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="OrbitaskWidgetCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">0</item>
        <item name="android:textColor">#F3F5F7</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="OrbitaskWidgetCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#AAB2BC</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
