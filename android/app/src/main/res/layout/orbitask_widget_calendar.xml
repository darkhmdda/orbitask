<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orbitask_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_calendar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Octubre 2026"
            android:textColor="#F3F5F7"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_calendar_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/orbitask_widget_chip"
            android:gravity="center"
            android:text="+"
            android:textColor="#A8BD86"
            android:textSize="27sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="   L    M    X    J    V    S    D"
        android:textColor="#AAB2BC"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="7dp"
        android:textColor="#F3F5F7"
        android:textSize="12sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="• número = tareas de ese día"
        android:textColor="#A8BD86"
        android:textSize="10sp"/>
</LinearLayout>
