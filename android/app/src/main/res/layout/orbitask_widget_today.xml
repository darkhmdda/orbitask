<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orbitask_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Todas las tareas"
            android:textColor="#F3F5F7"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_today_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/orbitask_widget_chip"
            android:gravity="center"
            android:text="+"
            android:textColor="#A8BD86"
            android:textSize="28sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No hay tareas pendientes"
        android:textColor="#AAB2BC"
        android:textSize="14sp"/>

    <TextView android:id="@+id/widget_today_task_1" style="@style/OrbitaskWidgetTaskRow"/>
    <TextView android:id="@+id/widget_today_task_2" style="@style/OrbitaskWidgetTaskRow"/>
    <TextView android:id="@+id/widget_today_task_3" style="@style/OrbitaskWidgetTaskRow"/>
    <TextView android:id="@+id/widget_today_task_4" style="@style/OrbitaskWidgetTaskRow"/>
    <TextView android:id="@+id/widget_today_task_5" style="@style/OrbitaskWidgetTaskRow"/>
    <TextView android:id="@+id/widget_today_task_6" style="@style/OrbitaskWidgetTaskRow"/>
</LinearLayout>
